{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.authority-registry.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "responsibilities",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.authority-registry.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "responsibility",
          "owner_target_id",
          "source_of_truth",
          "consumers",
          "allowed_roles",
          "prohibited_owner_target_ids",
          "enforcement",
          "validation_gate_ids",
          "definition_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AUTH-[0-9]{3,}$"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "owner_target_id": {
            "type": "string",
            "minLength": 1
          },
          "source_of_truth": {
            "type": "string",
            "minLength": 1
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "authority",
                "proposal_source",
                "projection",
                "cache",
                "display"
              ]
            }
          },
          "prohibited_owner_target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "enforcement": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_gate_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "definition_status": {
            "enum": [
              "active",
              "superseded",
              "retired"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_owner_per_responsibility",
        "projection_does_not_transfer_authority",
        "unresolved_conflict_result"
      ],
      "properties": {
        "one_owner_per_responsibility": {
          "const": true
        },
        "projection_does_not_transfer_authority": {
          "const": true
        },
        "unresolved_conflict_result": {
          "const": "BLOCKED"
        }
      }
    }
  }
}
