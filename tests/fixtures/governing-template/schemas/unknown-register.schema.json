{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.unknown-register.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "unknowns",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.unknown-register.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "owner",
          "blocks",
          "safe_state",
          "resolution_requirements",
          "resolution_evidence_ids",
          "status",
          "resolved_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UNK-[0-9]{3,}$"
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safe_state": {
            "type": "string",
            "minLength": 1
          },
          "resolution_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "accepted_risk",
              "superseded"
            ]
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
