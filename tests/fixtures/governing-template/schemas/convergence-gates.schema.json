{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.convergence-gates.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "gates",
    "result_values",
    "unknown_is_non_passing"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.convergence-gates.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "definition_status",
          "owner",
          "class",
          "scope",
          "method",
          "pass_condition",
          "fail_condition",
          "blocking",
          "required_evidence_ids",
          "waiver_allowed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GATE-[0-9]{3,}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition_status": {
            "enum": [
              "draft",
              "active",
              "superseded",
              "retired"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "authority",
              "contract",
              "execution",
              "validation",
              "migration",
              "release",
              "operations",
              "security"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "wave_ids",
              "task_ids"
            ],
            "properties": {
              "wave_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "task_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "method": {
            "type": "object",
            "required": [
              "type",
              "steps"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "pass_condition": {
            "type": "string",
            "minLength": 1
          },
          "fail_condition": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "required_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "waiver_allowed": {
            "type": "boolean"
          }
        }
      }
    },
    "result_values": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PASS",
          "FAIL",
          "BLOCKED",
          "UNKNOWN",
          "NOT_APPLICABLE_WITH_REASON"
        ]
      }
    },
    "unknown_is_non_passing": {
      "const": true
    }
  }
}
