{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.program.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.program.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "owner",
        "definition_status",
        "snapshot_at",
        "objective",
        "problem_statement",
        "target_state",
        "scope",
        "contracts",
        "authority_order",
        "operating_rules",
        "terminal_verdicts"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "const": "{{PROGRAM_ID}}"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "definition_status": {
          "enum": [
            "draft",
            "accepted",
            "superseded",
            "retired"
          ]
        },
        "snapshot_at": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "target_state": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include",
            "exclude"
          ],
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blueprint",
            "controller_minimum",
            "pair"
          ],
          "properties": {
            "blueprint": {
              "const": "program-execution-blueprint.v2"
            },
            "controller_minimum": {
              "const": "program-execution-controller.v2"
            },
            "pair": {
              "const": "program-execution-system.v2"
            }
          }
        },
        "authority_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "operating_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal_verdicts": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONVERGED",
              "CONVERGED_WITH_NON_BLOCKING_RISKS",
              "NOT_CONVERGED",
              "INCONCLUSIVE"
            ]
          }
        }
      }
    }
  }
}
