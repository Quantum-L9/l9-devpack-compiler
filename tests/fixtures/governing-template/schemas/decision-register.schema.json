{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.decision-register.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "decisions",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.decision-register.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "status",
          "owner",
          "options",
          "selected_option",
          "rationale",
          "evidence_ids",
          "blocks",
          "required_by",
          "supersedes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DEC-[0-9]{3,}$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected",
              "superseded"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "description",
                "benefits",
                "risks"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "benefits": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "risks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "selected_option": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_by": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  }
}
